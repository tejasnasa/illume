# Credentials for the production smoke suite (`npm run test:e2e:prod`).
#
# Copy to `client/.env.smoke` and fill in. That file is gitignored; this one is not, so it
# must never hold a real value.
#
# In CI these arrive as environment variables instead -- SMOKE_BASE_URL, SMOKE_API_URL and
# SMOKE_REPO_NAME from repository variables, SMOKE_EMAIL and SMOKE_PASSWORD from repository
# secrets. Real environment variables always win over this file.

# The deployed origins. Both are checked against an allow-list and must be https; the suite
# refuses to start otherwise.
SMOKE_BASE_URL=https://illume.tejasnasa.me
SMOKE_API_URL=https://illume-api.tejasnasa.me

# The account the suite drives. It signs in through `POST /api/v1/auth/login`, so it must
# have a password -- one created only through GitHub OAuth cannot sign in this way.
SMOKE_EMAIL=
SMOKE_PASSWORD=

# The repository that account already owns and that the specs browse. It must be finished
# ingesting; setup fails with a legible message if it is missing or not `ready`.
SMOKE_REPO_NAME=

# Optional. Only needed if the suite is ever pointed at a different pair of origins; the
# defaults are the two hosts above. SMOKE_COOKIE_DOMAIN is the registrable domain the
# session cookie must be scoped to.
# SMOKE_ALLOWED_HOSTS=illume.tejasnasa.me
# SMOKE_ALLOWED_API_HOSTS=illume-api.tejasnasa.me
# SMOKE_COOKIE_DOMAIN=tejasnasa.me

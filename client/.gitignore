# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
# Credentials for the production smoke suite, which drives the deployed site with a real
# account. Listed by exact name like `.env` above, so it has to be named here too or the
# production password would be tracked.
.env.smoke

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
/test-results/
/playwright-report/
/blob-report/
/e2e/.auth/
# The config's `outputDir` resolves against the config file (`e2e/`) while the HTML
# reporter's default resolves against the working directory (`client/`), so the two
# land in different places and both need naming.
/e2e/test-results/

# The production smoke suite names its report folder explicitly so it cannot overwrite
# the local suite's, and writes its session state and traces under its own directory.
/e2e-prod/.auth/
/e2e-prod/test-results/
/e2e-prod/playwright-report/

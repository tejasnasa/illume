# Backend API base URL the mobile client talks to.
#
# The mobile client uses this for ``/auth/me`` validation and any future API
# calls. It must be reachable from the device that runs the app, so for an
# Android phone on the same Wi-Fi as your laptop this is your laptop's LAN
# IP (``http://192.168.x.x:8000``), not ``localhost`` -- the phone and the
# laptop are different hosts.
#
# If you run the backend inside Docker on the same machine and your phone
# hits it, the URL should still point at the host (not the container),
# because the phone is not on the same network namespace as the container.
#
# When this variable is unset, the dev fallback resolves to
# ``http://10.0.2.2:8000`` -- the Android emulator's special alias for the
# host machine. That works for emulator-on-laptop; for a real device, copy
# this file to ``.env`` and replace the value with your laptop's IP.
EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Copy to server/evals/.env.eval (gitignored) and fill in. Missing keys are treated as
# empty; a command that needs one fails at use time with a clear message.

# OpenAI key: embeddings and the question phraser.
OPENAI_API_KEY=
# Generator key (DeepSeek).
AI_API_KEY=
# Generator base URL override. Leave empty for the registry default.
AI_BASE_URL=
# OpenRouter key: the decider, the rerankers and the judge.
OPENROUTER_API_KEY=
# GitHub token used for mining pull requests and issues.
GITHUB_TOKEN=

# The judge defaults to the pinned judge model on OpenRouter over chat completions, with
# OPENROUTER_API_KEY. Set these to try another judge on an OpenAI-compatible endpoint.
# Judge model id. Leave empty for the pinned default.
JUDGE_MODEL=
# Judge base URL. Leave empty for OpenRouter.
JUDGE_BASE_URL=
# Judge key. Leave empty to use OPENROUTER_API_KEY on OpenRouter or OPENAI_API_KEY on
# api.openai.com; required for any other host, so neither key is ever sent elsewhere.
JUDGE_API_KEY=
# Judge transport: `chat` (default) for chat completions, or `responses`.
JUDGE_API_STYLE=

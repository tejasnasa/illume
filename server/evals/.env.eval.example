# Copy to server/evals/.env.eval (gitignored) and fill in. Missing keys are treated as
# empty; a command that needs one fails at use time with a clear message.

# OpenAI key: embeddings, plus the judge and the question phraser.
OPENAI_API_KEY=
# Generator key (DeepSeek).
AI_API_KEY=
# Generator base URL override. Leave empty for the registry default.
AI_BASE_URL=
# OpenRouter key: the decider and the rerankers.
OPENROUTER_API_KEY=
# GitHub token used for mining pull requests and issues.
GITHUB_TOKEN=

# The judge defaults to the pinned judge model on OpenAI's Responses API with OPENAI_API_KEY.
# Set these to try another judge, for example a free model on an OpenAI-compatible endpoint.
# Judge model id. Leave empty for the pinned default.
JUDGE_MODEL=
# Judge base URL. Leave empty for OpenAI's own endpoint.
JUDGE_BASE_URL=
# Judge key. Leave empty to use OPENAI_API_KEY; required when JUDGE_BASE_URL is set, so the
# OpenAI key is never sent to another host.
JUDGE_API_KEY=
# Judge transport: `responses` (default) or `chat` for chat completions.
JUDGE_API_STYLE=

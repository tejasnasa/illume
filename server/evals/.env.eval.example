# Copy to server/evals/.env.eval (gitignored) and fill in. Missing keys are treated as
# empty; a command that needs one fails at use time with a clear message.

# OpenAI key: embeddings, plus the judge and the question phraser.
OPENAI_API_KEY=
# Generator key (DeepSeek).
AI_API_KEY=
# Generator base URL override. Leave empty for the registry default.
AI_BASE_URL=
# OpenRouter key: the decider and the rerankers.
OPENROUTER_API_KEY=
# GitHub token used for mining pull requests and issues.
GITHUB_TOKEN=

# Database Connection Parameters
# Async PostgreSQL URL (e.g. using postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/illume

# Sync PostgreSQL URL (used by Alembic migrations)
SYNC_DATABASE_URL=postgresql://username:password@localhost:5432/illume

# Redis Broker URL (used by Celery and WebSockets Pub-Sub)
REDIS_URL=redis://localhost:6379/0

# OpenAI API Key (used for RAG embeddings only). Glossi, reading order,
# architecture brief, and chat generation now go through the BYOK pipeline
# -- the user supplies their own key in /settings, except for the
# one-ingestion free tier which runs on AI_API_KEY below.
OPENAI_API_KEY=your-openai-api-key-here

# Server-side LLM credential for the free tier. Empty disables the free
# tier (a keyless user gets 402 on every entry point). When set, the first
# ingest for any user without a stored key runs on this credential, and
# their first five chat questions do too. Must be a key on the provider
# named by AI_BASE_URL; leave AI_BASE_URL empty to use the DeepSeek
# default (the server's free-tier preset).
AI_API_KEY=

# Free-tier LLM settings. Both default to the DeepSeek preset when empty.
# Override only if you want to point the operator's free-tier spend at a
# model or host other than the registry default. These are free-tier-only;
# the four BYOK generation services read the user's stored key instead.
AI_MODEL=
AI_BASE_URL=

# Authentication Security Settings
SECRET_KEY=generate-a-secure-random-secret-key-for-jwt-signing
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Client Application URL
FRONTEND_URL=http://localhost:3000

# Server Execution Environment (development, production)
ENVIRONMENT=development

# GitHub OAuth integration (for user login and cloning private repositories)
GITHUB_CLIENT_ID=your-github-oauth-app-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-secret
GITHUB_REDIRECT_URL=http://localhost:8000/api/v1/auth/github/callback

# Cookie domain. A bare hostname, not a URL -- this value is written straight
# into the cookie's Domain attribute, where a scheme or a port is invalid.
DOMAIN=localhost

# Contact form delivery (Resend). The endpoint refuses submissions with a 503
# while either of the first two is empty, rather than accepting a message it
# has no way to deliver.
#
# RESEND_API_KEY must belong to the Resend account that has CONTACT_FROM_EMAIL's
# domain verified; a key from another account sends nothing and fails with
# "domain not verified".
# CONTACT_FROM_EMAIL must be a bare address on that verified domain. Do NOT wrap
# it in quotes or add a display name: Docker's --env-file parser does no quote
# processing, so the quotes would become part of the value and Resend would
# reject the mailbox.
RESEND_API_KEY=**********
CONTACT_TO_EMAIL=operator@example.com
CONTACT_FROM_EMAIL=contact@illume.tejasnasa.me

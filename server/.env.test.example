# Environment used by the backend test suite.
#
# You do not normally need this file. tests/conftest.py sets every value below
# programmatically, before any `app.*` import, precisely because Settings and the
# database engines are constructed at import time. This file documents the contract
# and is useful when running a one-off script against the test stack.
#
# Start the stack first:
#   docker compose -f docker-compose.test.yml up -d

# Ports are offset from the dev defaults (5432 / 6379) so a running dev stack is
# never silently reused. The suite asserts on these ports -- see pytest_configure.
DATABASE_URL=postgresql+asyncpg://illume:test@localhost:5433/illume_test
SYNC_DATABASE_URL=postgresql://illume:test@localhost:5433/illume_test
REDIS_URL=redis://localhost:6380/0

# Not a real credential. Never point the suite at a real OpenAI key: the tests would
# then make billed network calls instead of using mocks.
OPENAI_API_KEY=test-openai-key
AI_MODEL=gpt-4o-mini

SECRET_KEY=test-secret-key-not-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# Was missing from .env.example, which meant a fresh `cp .env.example .env` could not
# instantiate Settings at all. .env.example now carries it too; this copy stays because
# the value it needs is the same.
#
# A bare hostname, NOT a URL: this value is passed straight through as the session
# cookie's `Domain` attribute, and a scheme or port there is not a valid cookie domain.
DOMAIN=localhost

GITHUB_CLIENT_ID=test-github-client-id
GITHUB_CLIENT_SECRET=test-github-client-secret
GITHUB_REDIRECT_URL=http://localhost:8000/api/v1/auth/github/callback

# Contact form delivery. The key is a placeholder, never a real credential: the tests
# intercept the outbound call at the transport layer, so nothing reaches Resend.
RESEND_API_KEY=re_test_key_not_a_real_credential
CONTACT_TO_EMAIL=operator@example.com
CONTACT_FROM_EMAIL=contact@illume.tejasnasa.me
